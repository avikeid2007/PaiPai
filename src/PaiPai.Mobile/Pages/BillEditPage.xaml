<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaiPai.Mobile.Pages.BillEditPage" Title="Bill reminder" BackgroundColor="{StaticResource Canvas}">
    <ScrollView>
        <VerticalStackLayout Padding="20,14,20,28" Spacing="15">
            <Border BackgroundColor="{StaticResource PrimaryDeep}" StrokeThickness="0" Padding="18">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                    <Border BackgroundColor="#2B5A4C" HeightRequest="42" WidthRequest="42">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Label Text="◷" FontSize="23" TextColor="{StaticResource Lime}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Keep future-you ahead" FontSize="16" FontAttributes="Bold" TextColor="White" />
                        <Label Text="One place for recurring bills and due dates" FontSize="12" TextColor="#D4E3DA" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" Padding="17">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="REMINDER DETAILS" Style="{StaticResource Eyebrow}" />
                    <Label Text="Name" FontSize="12" TextColor="{StaticResource Muted}" />
                    <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="10,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding Name}" Placeholder="Internet, rent, streaming" Style="{StaticResource FieldEntry}" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Amount (optional)" FontSize="12" TextColor="{StaticResource Muted}" />
                            <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="9,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                <Entry Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="₹0" Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Next due date" FontSize="12" TextColor="{StaticResource Muted}" />
                            <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="7,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                                <DatePicker Date="{Binding DueDate}" Style="{StaticResource FieldDatePicker}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Repeats" FontSize="12" TextColor="{StaticResource Muted}" />
                    <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="7,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Picker ItemsSource="{Binding Cadences}" SelectedItem="{Binding Cadence}" Style="{StaticResource FieldPicker}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" Padding="17">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="11">
                    <Label Text="REMINDER SETTINGS" Style="{StaticResource Eyebrow}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding ReminderEnabled}" Color="{StaticResource Primary}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Notify me before it’s due" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            <Label Text="A local notification will be scheduled on this device" FontSize="12" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Days in advance" FontSize="12" TextColor="{StaticResource Muted}" />
                    <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="7,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Picker ItemsSource="{Binding ReminderDayOptions}" SelectedItem="{Binding ReminderDaysBefore}" Style="{StaticResource FieldPicker}" />
                    </Border>
                    <Label Text="Account / card digits (optional)" FontSize="12" TextColor="{StaticResource Muted}" />
                    <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="10,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding AccountHint}" Keyboard="Numeric" MaxLength="4" Placeholder="Last 4 digits" Style="{StaticResource FieldEntry}" />
                    </Border>
                    <Label Text="Note" FontSize="12" TextColor="{StaticResource Muted}" />
                    <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="10,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <Entry Text="{Binding Note}" Placeholder="Optional" Style="{StaticResource FieldEntry}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{StaticResource Primary}" />
            <Button Text="Save reminder" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" HeightRequest="54" />
            <Button Text="Delete reminder" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditing}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
