<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaiPai.Mobile.Pages.HomePage" Title="Home"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Canvas}">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="Pai Pai" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="YOUR MONEY, IN FOCUS" Style="{StaticResource Eyebrow}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="•••" Command="{Binding SettingsCommand}"
                        Style="{StaticResource SecondaryButton}" WidthRequest="48" HeightRequest="48" Padding="0" />
            </Grid>

            <Border Padding="22" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="26" /></Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#123D34" Offset="0" />
                        <GradientStop Color="#08705B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,56" ColumnSpacing="12">
                    <Label Text="MONTHLY OUTFLOW" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="#BFD6C9" />
                    <Border Grid.Column="1" Grid.RowSpan="2" BackgroundColor="#2A7763" Padding="0" HeightRequest="52" WidthRequest="52" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                        <Label Text="₹" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Lime}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Grid.Row="1" Text="Spent this month" FontSize="14" TextColor="#E1ECE5" Margin="0,7,0,0" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding MonthTotal}" FontSize="38" FontAttributes="Bold" TextColor="White" Margin="0,5,0,0" />
                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,17,0,0">
                        <Label Text="●" FontSize="9" TextColor="{StaticResource Lime}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Confirmed transactions only" FontSize="12" TextColor="#D4E3DA" VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="＋  Add transaction" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}" />
                <Button Grid.Column="1" Text="Import SMS" Command="{Binding ImportSmsCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource SoftAmber}" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReviewSmsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Label Text="NEEDS A LOOK" Style="{StaticResource Eyebrow}" TextColor="#806323" />
                        <Label Grid.Row="1" Text="{Binding PendingCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Ink}" Margin="0,5,0,0" />
                        <Label Grid.Row="2" Text="Messages to review" FontSize="12" TextColor="#665C43" />
                        <Label Grid.Column="1" Grid.RowSpan="3" Text="›" FontSize="27" TextColor="#806323" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BillsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <Label Text="COMING UP" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Primary}" />
                        <Label Grid.Row="1" Text="{Binding UpcomingBillCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Ink}" Margin="0,5,0,0" />
                        <Label Grid.Row="2" Text="Bills &amp; reminders" FontSize="12" TextColor="{StaticResource PrimaryDeep}" />
                        <Label Grid.Column="1" Grid.RowSpan="3" Text="›" FontSize="27" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,-4">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Recent activity" Style="{StaticResource SectionTitle}" />
                    <Label Text="The latest from your accounts" Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="See all  ›" Command="{Binding HistoryCommand}" Style="{StaticResource QuietButton}" VerticalOptions="Center" />
            </Grid>

            <Label Text="No transactions yet. Add one or import your SMS history to get started."
                   IsVisible="{Binding HasNoRecent}" Style="{StaticResource BodyMuted}" Margin="2,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recent}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeThickness="1" Padding="13" Margin="0,0,0,9">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailsCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="11">
                                <Border BackgroundColor="{StaticResource SoftGreen}" HeightRequest="42" WidthRequest="42" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                    <Label Text="↘" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Merchant}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DisplayCategory}" FontSize="12" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding Amount, StringFormat='₹{0:N2}'}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource Ink}" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding Direction}" FontSize="12" TextColor="{StaticResource Muted}" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
