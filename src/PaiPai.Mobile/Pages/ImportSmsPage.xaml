<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaiPai.Mobile.Pages.ImportSmsPage" Title="Import SMS" BackgroundColor="{StaticResource Canvas}">
    <ScrollView>
        <VerticalStackLayout Padding="20,14,20,28" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Import messages" Style="{StaticResource PageTitle}" />
                <Label Text="Turn bank alerts into a clear activity history" Style="{StaticResource BodyMuted}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PrimaryDeep}" StrokeThickness="0" Padding="18">
                <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="11">
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                        <Border BackgroundColor="#2B5A4C" HeightRequest="40" WidthRequest="40">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label Text="↗" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Lime}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="On-device and private" FontSize="16" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Only relevant financial alerts are kept" FontSize="12" TextColor="#D4E3DA" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#45665A" />
                    <Label Text="SMS stays on this phone. Clear transaction matches are added automatically; uncertain messages stay in Review. You can edit or delete any transaction later."
                           FontSize="13" TextColor="#E1ECE5" LineHeight="1.25" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" Padding="17">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="IMPORT STATUS" Style="{StaticResource Eyebrow}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{Binding Status}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding ProgressText}" FontSize="12" TextColor="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Text="{Binding ButtonText}" Command="{Binding ImportCommand}" Style="{StaticResource AccentButton}" />
                    <Button Text="Stop safely" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SoftAmber}" StrokeThickness="0" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Review queue" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label Text="Check only messages Pai Pai couldn’t read clearly" FontSize="12" TextColor="#665C43" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{Binding PendingCount, StringFormat='Open ({0})'}" Command="{Binding OpenReviewCommand}"
                            BackgroundColor="White" TextColor="{StaticResource Ink}" CornerRadius="13" FontAttributes="Bold" HeightRequest="42" Padding="12,6" />
                </Grid>
            </Border>

            <Button Text="Back to Home" Command="{Binding HomeCommand}" Style="{StaticResource QuietButton}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
