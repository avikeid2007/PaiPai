<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaiPai.Mobile.Pages.SmsReviewPage" Title="Review"
             Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource Canvas}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,10" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="3">
                <Label Text="Needs your eye" Style="{StaticResource PageTitle}" FontSize="27" />
                <Label Text="Only the uncertain messages land here" Style="{StaticResource BodyMuted}" />
            </VerticalStackLayout>
            <Border Grid.Column="1" BackgroundColor="{StaticResource SoftAmber}" Padding="11,7" VerticalOptions="Center">
                <Border.StrokeShape><RoundRectangle CornerRadius="13" /></Border.StrokeShape>
                <Label Text="{Binding MessageCount}" FontSize="13" FontAttributes="Bold" TextColor="#806323" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="7">
            <Button Text="Home" Command="{Binding HomeCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="42" FontSize="12" Padding="7,5" />
            <Button Grid.Column="1" Text="History" Command="{Binding HistoryCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="42" FontSize="12" Padding="7,5" />
            <Button Grid.Column="2" Text="＋ Add" Command="{Binding AddManuallyCommand}" Style="{StaticResource AccentButton}" HeightRequest="42" FontSize="12" Padding="7,5" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Messages}" SelectionMode="None" Margin="0,2,0,0">
            <CollectionView.EmptyView>
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" Padding="22" Margin="0,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="9">
                        <Border BackgroundColor="{StaticResource SoftGreen}" HeightRequest="48" WidthRequest="48">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Label Text="✓" FontSize="22" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="All clear" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label Text="There are no uncertain financial messages to review." Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeThickness="1" Padding="15" Margin="0,0,0,11">
                        <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="11">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Sender}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" />
                                    <Label Text="Needs review" FontSize="11" FontAttributes="Bold" TextColor="#806323" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding ReceivedAt, StringFormat='{0:dd MMM, h:mm tt}'}" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Start" />
                            </Grid>
                            <Border BackgroundColor="{StaticResource Canvas}" StrokeThickness="0" Padding="12">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Label Text="{Binding Body}" FontSize="13" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" MaxLines="7" />
                            </Border>
                            <Label Text="{Binding Reason}" FontSize="12" TextColor="{StaticResource Muted}" />
                            <Border IsVisible="{Binding HasCandidate}" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" Padding="12">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="SUGGESTED AMOUNT" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding Amount, StringFormat='₹{0:N2}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Direction}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Confirm &amp; add" IsVisible="{Binding HasCandidate}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmCommand}"
                                        CommandParameter="{Binding .}" Style="{StaticResource PrimaryButton}" HeightRequest="44" FontSize="13" Padding="8,5" />
                                <Button Grid.Column="1" Text="Ignore" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IgnoreCommand}"
                                        CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" HeightRequest="44" FontSize="13" Padding="8,5" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
