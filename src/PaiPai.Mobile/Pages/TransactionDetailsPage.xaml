<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaiPai.Mobile.Pages.TransactionDetailsPage" Title="Details" BackgroundColor="{StaticResource Canvas}">
    <ScrollView>
        <VerticalStackLayout Padding="20,14,20,28" Spacing="14">
            <Border Padding="20" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#123D34" Offset="0" />
                        <GradientStop Color="#08705B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="8">
                    <Label Text="TRANSACTION" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="#BFD6C9" />
                    <Label Text="{Binding Entry.DisplayMerchant}" FontSize="21" FontAttributes="Bold" TextColor="White" LineBreakMode="WordWrap" />
                    <Label Text="{Binding AmountText}" FontSize="35" FontAttributes="Bold" TextColor="{StaticResource Lime}" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Text="{Binding DirectionText}" FontSize="13" TextColor="#E1ECE5" />
                        <Label Grid.Column="1" Text="{Binding ConfirmationText}" FontSize="12" FontAttributes="Bold" TextColor="#D4E3DA" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" Padding="17">
                <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="PAYMENT DETAILS" Style="{StaticResource Eyebrow}" />
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                        <Label Text="◷" FontSize="19" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="DATE &amp; TIME" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding DateText}" FontSize="14" TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                        <Label Text="◈" FontSize="19" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="CATEGORY" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding Entry.Category}" FontSize="14" TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                        <Label Text="▣" FontSize="19" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="PAYMENT METHOD" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding Entry.Method}" FontSize="14" TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                        <Label Text="◉" FontSize="19" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="ACCOUNT OR CARD" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding AccountText}" FontSize="14" TextColor="{StaticResource Ink}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Label Text="{Binding BalanceText}" FontSize="13" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding ReferenceText}" FontSize="13" TextColor="{StaticResource Muted}" />
                    <Label Text="{Binding SourceText}" FontSize="13" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="19" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOTE" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding NoteText}" FontSize="14" TextColor="{StaticResource Ink}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Status}" TextColor="{StaticResource Danger}" FontSize="13" />
            <Button Text="Edit transaction" Command="{Binding EditCommand}" Style="{StaticResource AccentButton}" />
            <Button Text="Delete transaction" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                <Button Text="History" Command="{Binding HistoryCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="44" />
                <Button Grid.Column="1" Text="Home" Command="{Binding HomeCommand}" Style="{StaticResource SecondaryButton}" HeightRequest="44" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
